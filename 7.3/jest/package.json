{
  "name": "jest-coverage",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "jest",
    "coverage": "jest --collectCoverage"
  },
  "devDependencies": {
    "jest": "^26.6.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.{js,jsx}",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}

   


